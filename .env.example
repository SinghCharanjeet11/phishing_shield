# PhishingShield settings. Copy to .env and adjust if needed.
# No secrets belong here; .env is gitignored.

# Where the Streamlit frontend reaches the FastAPI backend.
# Local run: http://127.0.0.1:8000. docker compose sets http://api:8000 itself.
API_URL=http://127.0.0.1:8000

# Folder with model.joblib and model_metadata.json (read by the API, written by training).
MODEL_DIR=artifacts/model

# MLflow tracking store used by training.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
